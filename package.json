{
  "name": "java-for-nestjs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.20.0 <23 || >=24.0.0"
  },
  "scripts": {
    "docs:prepare": "node scripts/generate-course-index.mjs",
    "docs:dev": "node scripts/generate-course-index.mjs && vitepress dev docs --host 127.0.0.1",
    "docs:build": "node scripts/generate-course-index.mjs && vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1",
    "docs:typecheck": "vue-tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.19.3",
    "mermaid": "11.12.2",
    "typescript": "5.9.3",
    "vitepress": "1.6.4",
    "vue": "3.5.45",
    "vue-tsc": "3.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
