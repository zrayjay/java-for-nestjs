{
  "name": "java-for-nestjs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.20.0 <23 || >=24.0.0"
  },
  "scripts": {
    "docs:prepare": "node scripts/generate-course-index.mjs",
    "docs:dev": "node scripts/generate-course-index.mjs && vitepress dev docs --host 127.0.0.1",
    "docs:build": "node scripts/generate-course-index.mjs && vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1",
    "docs:typecheck": "vue-tsc --noEmit",
    "examples:build": "pnpm --filter @java-for-nestjs/nestjs-reference build",
    "examples:test": "pnpm --filter @java-for-nestjs/nestjs-reference test",
    "examples:start": "pnpm --filter @java-for-nestjs/nestjs-reference start",
    "examples:verify": "node scripts/verify-greeting-contract.mjs && node scripts/verify-runtime-lab.mjs",
    "runtime:verify": "node scripts/verify-runtime-lab.mjs",
    "transactions:build": "pnpm --filter @java-for-nestjs/prisma-reference build",
    "transactions:test": "pnpm --filter @java-for-nestjs/prisma-reference test",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "deps:audit": "pnpm audit --audit-level high",
    "js:check": "node scripts/check-js-syntax.mjs",
    "chapters:check": "node scripts/check-doc-structure.mjs && node scripts/check-example-links.mjs && node scripts/verify-compatibility.mjs",
    "chapters:test": "node --test scripts/tests/*.test.mjs",
    "docs:links": "node scripts/check-example-links.mjs --built"
  },
  "devDependencies": {
    "@types/node": "22.19.3",
    "markdown-it": "14.3.3",
    "mermaid": "11.12.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitepress": "1.6.4",
    "vue": "3.5.45",
    "vue-tsc": "3.1.8",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "vite": "6.4.4",
      "lodash-es": "4.18.1"
    }
  }
}
